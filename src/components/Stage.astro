---
// The ruler. One component for the home page and every landing page.
// The stage has a fixed height from first paint, so nothing jumps when the script starts.
import '../styles/ruler.css';
interface Props { h1: string; lede: string; unit?: string; edges?: string; openCal?: boolean; }
const { h1, lede, unit = 'both', edges = 'top,left', openCal = false } = Astro.props;
const units = [['cm', 'cm'], ['mm', 'mm'], ['in', 'in'], ['px', 'px'], ['both', 'cm + in']];
---
<section id="stage" class="stage" aria-label="Ruler" data-unit={unit} data-edges={edges} data-open-cal={openCal ? '1' : '0'}>
  <canvas id="rc" aria-hidden="true"></canvas>
  <div id="guides"></div>
  <div id="cross" hidden aria-hidden="true"><i class="cx"></i><i class="cy"></i><span id="cross-l" class="cl"></span></div>
  <div class="hit hit-top" data-edge="top" aria-hidden="true"></div>
  <div class="hit hit-right" data-edge="right" aria-hidden="true"></div>
  <div class="hit hit-bottom" data-edge="bottom" aria-hidden="true"></div>
  <div class="hit hit-left" data-edge="left" aria-hidden="true"></div>

  <div id="inner" class="inner">
    <div class="head">
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <p id="hint-full" class="hint hint-full">Press F for full screen. It gives the ruler the whole display.</p>
      <p id="hint-rotate" class="hint hint-rotate">Turn your phone sideways for a longer ruler.</p>
      <p class="hint hint-guide"><strong>A guide</strong> is a line you place at the end of your object. Press Add guide, then drag it.</p>
    </div>

    <div class="bar" role="toolbar" aria-label="Ruler controls">
      <button type="button" id="chip" class="chip" data-kind="estimate" aria-haspopup="dialog">
        <span class="dot" aria-hidden="true"></span><span id="chip-text">Not calibrated: sizes are an estimate</span><span class="sr-only">. Opens calibration.</span>
      </button>
      <p id="badge" class="badge" hidden><span aria-hidden="true">&#10003;</span> Calibrated, checked</p>
      <div id="seg" class="seg" role="radiogroup" aria-label="Unit">
        {units.map(([v, l]) => <button type="button" role="radio" data-unit={v} aria-checked={v === unit ? 'true' : 'false'}>{l}</button>)}
      </div>
      <button type="button" id="btn-guide" class="btn">Add guide</button>
      <button type="button" id="btn-full" class="btn" aria-pressed="false">Full screen</button>
      <button type="button" id="btn-more" class="btn" aria-expanded="false" aria-controls="more">Options</button>
    </div>

    <div id="more" class="more" hidden>
      <fieldset class="opt-group">
        <legend>Ruler edges</legend>
        <label class="chk"><input type="checkbox" id="edge-top" /> Top</label>
        <label class="chk"><input type="checkbox" id="edge-right" /> Right</label>
        <label class="chk"><input type="checkbox" id="edge-bottom" /> Bottom</label>
        <label class="chk"><input type="checkbox" id="edge-left" /> Left</label>
      </fieldset>
      <div class="opt-group">
        <label class="chk"><input type="checkbox" id="opt-snap" /> Snap guides to marks</label>
        <label class="chk"><input type="checkbox" id="opt-cross" /> Crosshair (key C)</label>
        <label class="sel">Ruler paper
          <select id="opt-paper">
            <option value="auto">Match theme</option><option value="light">Light</option><option value="dark">Dark</option><option value="contrast">High contrast</option>
          </select>
        </label>
      </div>
      <div class="opt-group">
        <button type="button" class="btn" id="opt-add-x">Add vertical guide</button>
        <button type="button" class="btn" id="opt-add-y">Add horizontal guide</button>
        <button type="button" class="btn" id="opt-clear">Clear guides</button>
        <button type="button" class="btn" id="opt-reset" hidden>Reset calibration</button>
      </div>
      <p class="small">Drag from a ruler to pull out a guide. Use arrow keys on a focused guide. Delete removes it.</p>
    </div>

    <div id="notice" class="notice" role="status" hidden></div>

    <div id="callout" class="callout" hidden>
      <p><strong>Step 1: make the ruler true to size.</strong> These sizes are a guess until you hold a credit card against the screen and match it to an outline.</p>
      <div class="row">
        <button type="button" id="callout-go" class="btn primary">Calibrate with a card</button>
        <button type="button" id="callout-x" class="btn">Not now</button>
      </div>
    </div>

    <div id="readout" class="readout" hidden></div>
  </div>

  <div id="obj" class="obj" hidden data-kind="rect">
    <span id="obj-l" class="obj-l"></span>
    <div id="obj-h" class="obj-h" role="slider" tabindex="0" aria-label="Resize the outline to match your object. Arrow keys change it by 0.1 millimeter." aria-valuemin="1" aria-valuemax="20" aria-valuenow="6"><i></i></div>
  </div>

  <section id="cal" class="cal" role="dialog" aria-modal="false" aria-labelledby="cal-h" hidden>
    <div class="cal-top">
      <h2 id="cal-h" tabindex="-1">Calibrate your screen</h2>
      <button type="button" id="cal-close" class="btn" aria-label="Close calibration">Close</button>
    </div>

    <div id="cal-pick">
      <div role="tablist" aria-label="Calibration method" class="tabs">
        <button type="button" role="tab" id="tab-card" aria-controls="pane-card" aria-selected="true">Card</button>
        <button type="button" role="tab" id="tab-coin" aria-controls="pane-coin" aria-selected="false" tabindex="-1">Coin</button>
        <button type="button" role="tab" id="tab-device" aria-controls="pane-device" aria-selected="false" tabindex="-1">Device</button>
        <button type="button" role="tab" id="tab-size" aria-controls="pane-size" aria-selected="false" tabindex="-1">Size</button>
      </div>

      <div role="tabpanel" id="pane-card" aria-labelledby="tab-card">
        <ol class="steps">
          <li>Hold a credit card flat against the screen.</li>
          <li>Line up one edge of the card with the outline.</li>
          <li>Drag the grip on the right edge until the other edge matches.</li>
        </ol>
        <p id="card-rot-note" class="small" hidden>Your screen is narrow, so the card is turned on its short side (53.98 mm).</p>
        <div class="row sticky-row">
          <button type="button" class="btn" data-nudge="-0.1" aria-label="Smaller by 0.1 millimeter">&minus; 0.1 mm</button>
          <button type="button" class="btn" data-nudge="0.1" aria-label="Larger by 0.1 millimeter">+ 0.1 mm</button>
          <button type="button" class="btn" id="card-rotate">Turn card</button>
          <button type="button" class="btn primary" data-fit>My card matches</button>
        </div>
      </div>

      <div role="tabpanel" id="pane-coin" aria-labelledby="tab-coin" hidden>
        <label class="sel">Object
          <select id="coin-select">
            <optgroup label="Coins">
              <option value="us-quarter">US quarter, 24.26 mm</option>
              <option value="us-dime">US dime, 17.91 mm</option>
              <option value="us-cent">US cent, 19.05 mm</option>
              <option value="us-nickel">US nickel, 21.21 mm</option>
              <option value="us-dollar">US dollar coin, 26.49 mm</option>
              <option value="us-half">US half dollar, 30.61 mm</option>
              <option value="eu-2c">Euro 2 cent, 18.75 mm</option>
              <option value="eu-50c">Euro 50 cent, 24.25 mm</option>
              <option value="eu-1e">Euro 1 euro, 23.25 mm</option>
              <option value="eu-2e">Euro 2 euro, 25.75 mm</option>
            </optgroup>
            <optgroup label="Paper (needs a wide screen)">
              <option value="letter">US Letter, 215.9 mm wide</option>
              <option value="a4">A4, 210 mm wide</option>
            </optgroup>
          </select>
        </label>
        <p id="coin-note" class="small"></p>
        <p class="small"><a id="coin-src" href="#" rel="noopener" target="_blank">Where this size comes from</a></p>
        <div class="row sticky-row">
          <button type="button" class="btn" data-nudge="-0.1" aria-label="Smaller by 0.1 millimeter">&minus; 0.1 mm</button>
          <button type="button" class="btn" data-nudge="0.1" aria-label="Larger by 0.1 millimeter">+ 0.1 mm</button>
          <button type="button" class="btn primary" data-fit>It matches</button>
        </div>
      </div>

      <div role="tabpanel" id="pane-device" aria-labelledby="tab-device" hidden>
        <label class="sel">Search your device
          <input type="search" id="dev-q" placeholder="iPhone 15, MacBook Air 13, monitor 27" autocomplete="off" />
        </label>
        <p id="dev-count" class="small"></p>
        <ul id="dev-list" class="devs"></ul>
        <p class="small">Not listed, or the size looks off? Use the credit card method. It is more exact.</p>
      </div>

      <div role="tabpanel" id="pane-size" aria-labelledby="tab-size" hidden>
        <div class="grid2">
          <label class="sel">Screen size (diagonal)<input type="text" inputmode="decimal" id="size-d" placeholder="15.6" /></label>
          <label class="sel">Unit<select id="size-u"><option value="in">inches</option><option value="cm">cm</option></select></label>
        </div>
        <label class="sel">Shape
          <select id="size-a">
            <option value="auto">Detect from this screen</option>
            <option value="1.7778">16:9</option><option value="1.6">16:10</option><option value="1.5">3:2</option>
            <option value="1.3333">4:3</option><option value="2.3333">21:9</option><option value="2.1667">19.5:9 (phones)</option>
          </select>
        </label>
        <div class="row sticky-row"><button type="button" class="btn primary" id="size-apply">Use this size</button></div>
        <p class="small">The size printed on the box is the diagonal of the screen. This gives an approximate result.</p>
      </div>
      <p id="cal-error" class="err" role="alert"></p>
      <p class="small">Keep the browser zoom the same while you measure. Your calibration is saved only in this browser.</p>
    </div>

    <div id="cal-verify" hidden>
      <h3>Check it</h3>
      <p>Lay the object on the screen. Does it fit the outline?</p>
      <label class="sel">Check with
        <select id="check-select"></select>
      </label>
      <div class="row sticky-row">
        <button type="button" class="btn primary" id="verify-yes">Yes, it fits</button>
        <button type="button" class="btn" id="verify-no">No</button>
        <button type="button" class="btn" id="verify-skip">Skip</button>
      </div>
    </div>

    <div id="cal-done" hidden>
      <p id="done-text"></p>
      <div class="row"><button type="button" class="btn primary" id="done-close">Start measuring</button></div>
    </div>
  </section>

  <p id="live" class="sr-only" aria-live="polite"></p>
  <p id="toast" class="toast" role="status" hidden></p>
  <noscript><p class="noscript">The ruler needs JavaScript. Turn it on to measure.</p></noscript>
</section>
<script>
  import { initStage } from '../lib/stage.js';
  initStage();
</script>
